<Window x:Class="pick14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pick14"
        mc:Ignorable="d"
        Title="Адаптивна фотогалерея" 
        Height="600" Width="900"
        MinHeight="400" MinWidth="300"
        WindowStartupLocation="CenterScreen"
        Background="#FFF0F2F5">

    <Window.Resources>
        <!-- Стиль для карточки зображення -->
        <Style x:Key="ImageCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E5E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Модальне вікно для перегляду -->
        <Border x:Name="ModalOverlay" 
                Background="#80000000" 
                Visibility="Collapsed"
                Panel.ZIndex="1000">
            <Border Background="White" 
                    CornerRadius="12"
                    Width="500"
                    Height="400"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <DockPanel Grid.Row="0" Margin="0 0 0 15">
                        <TextBlock x:Name="ModalTitle" 
                                  FontSize="16" 
                                  FontWeight="Bold"
                                  Foreground="#333"
                                  DockPanel.Dock="Left"/>
                        <Button Content="✕" 
                               Background="#FF6B6B6B"
                               Foreground="White"
                               Width="28"
                               Height="28"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"
                               Click="CloseModalButton_Click"
                               Cursor="Hand"/>
                    </DockPanel>

                    <!-- Велике зображення -->
                    <Image x:Name="ModalImage" 
                          Grid.Row="1"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          MaxWidth="450"
                          MaxHeight="300"/>

                    <!-- Інформація про адаптивність -->
                    <TextBlock Grid.Row="2"
                              Margin="0 15 0 0"
                              TextWrapping="Wrap"
                              FontSize="12"
                              Foreground="#666"
                              TextAlignment="Center"
                              Text="Галерея адаптується під розмір екрана. Спробуйте змінити розмір вікна!"/>
                </Grid>
            </Border>
        </Border>

        

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <TextBlock Text="🖼️ Адаптивна фотогалерея"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="AddImageButton" 
                   Content="➕ Додати фото" 
                   Style="{StaticResource ControlButtonStyle}"
                   Click="AddImageButton_Click"
                   ToolTip="Додати нові фотографії до галереї"/>

            <Button x:Name="ClearGalleryButton" 
                   Content="🗑️ Очистити" 
                   Style="{StaticResource ControlButtonStyle}"
                   Background="#F44336"
                   Click="ClearGalleryButton_Click"
                   ToolTip="Очистити всю галерею"/>
        </StackPanel>

        <!-- Галерея з горизонтальною прокруткою -->
        <ScrollViewer Grid.Row="2" 
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Disabled"
                     Padding="10"
                     Background="Transparent">
            <WrapPanel x:Name="GalleryWrapPanel" 
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Background="#E3F2FD" Padding="10">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" 
                          Text="Готово до перегляду" 
                          Foreground="#1976D2" 
                          FontWeight="Medium"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ImageCountText" 
                          Text="0 зображень" 
                          Foreground="#666" 
                          FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    </Grid>
</Window>
    
